# Python bytecode and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
coverage.xml
htmlcov/

# Packaging and virtual environments
build/
dist/
*.egg-info/
.venv/
venv/

# Local configuration and credentials
.env
.env.*
!.env.example

# Runtime output; project-state.json remains eligible for version control
.ipd/generated/
.ipd/*.tmp

# Editors, operating systems, and transient files
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log
*.tmp
*.bak
*.swp
*~
