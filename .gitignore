*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
coverage.xml
htmlcov/

# Packaging and virtual environments
build/
dist/
*.egg-info/
.venv/
venv/

# Local configuration and credentials
.env
.env.*
!.env.example

# Runtime output; task, process, and project state remain eligible for version control
.ipd/generated/
.ipd/dashboard/
