{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IPD Project State",
  "description": "Structural contract for .ipd/project_state.yaml. Progressive refinement requirement metadata belongs only to Deliverables; Activities are structural process nodes and are not execution-state requirement roots. Use ipdctl verify for cross-reference and workflow invariants.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "project",
    "claims",
    "deliverables",
    "gates",
    "traceability"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "revision": { "type": "integer", "minimum": 0 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "task_types",
        "phase",
        "workflow_step",
        "current_tr",
        "current_dcp",
        "current_gate"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "task_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["software", "hardware", "embedded", "robotics", "ai_system", "material_change"]
          }
        },
        "phase": {
          "enum": ["concept", "plan", "develop", "qualify", "launch", "lifecycle"]
        },
        "workflow_step": {
          "enum": ["context", "claim", "work", "close", "review", "refresh", "verify"]
        },
        "current_tr": { "type": ["string", "null"], "minLength": 1 },
        "current_dcp": { "type": ["string", "null"], "minLength": 1 },
        "current_gate": { "type": ["string", "null"], "minLength": 1 },
        "repository": { "$ref": "#/$defs/repository" }
      }
    },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    },
    "deliverables": {
      "type": "array",
      "items": { "$ref": "#/$defs/deliverable" }
    },
    "gates": {
      "type": "array",
      "items": { "$ref": "#/$defs/gate" }
    },
    "traceability": {
      "type": "array",
      "items": { "$ref": "#/$defs/trace" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "source_id"],
      "properties": {
        "layer": { "enum": ["core", "task_type", "capability", "project"] },
        "source_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["none", "git", "svn"] },
        "root": { "type": ["string", "null"], "minLength": 1 },
        "branch": { "type": ["string", "null"], "minLength": 1 },
        "revision": { "type": ["string", "null"], "minLength": 1 },
        "dirty": { "type": ["boolean", "null"] },
        "remote": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "status", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "statement": { "type": "string", "minLength": 1 },
        "status": { "enum": ["open", "supported", "rejected"] },
        "evidence": { "$ref": "#/$defs/stringList" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "supported" } } },
          "then": { "properties": { "evidence": { "minItems": 1 } } }
        }
      ]
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "review_required",
        "depends_on",
        "evidence",
        "reviews"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1 },
        "phase": { "type": ["string", "null"], "minLength": 1 },
        "activity_id": { "type": ["string", "null"], "minLength": 1 },
        "status": {
          "enum": [
            "planned",
            "in_progress",
            "ready_for_review",
            "in_review",
            "accepted",
            "rejected",
            "blocked",
            "superseded"
          ]
        },
        "review_required": { "type": "boolean" },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "evidence": { "$ref": "#/$defs/stringList" },
        "reviews": {
          "type": "array",
          "items": { "$ref": "#/$defs/review" }
        },
        "blocked_reason": { "type": ["string", "null"], "minLength": 1 },
        "replacement": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "replacements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "provenance": { "$ref": "#/$defs/provenance" },
        "maturity": {
          "enum": ["defined", "selected", "integrated", "verified", "released", "monitored"]
        },
        "definition_state": { "enum": ["concrete", "abstract", "placeholder"] },
        "refinement_required": { "type": "boolean" },
        "refinement_trigger": { "$ref": "#/$defs/refinementTrigger" },
        "refines": { "$ref": "#/$defs/identifier" },
        "requires_artifact_owner": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "required": ["definition_state"],
            "properties": { "definition_state": { "const": "placeholder" } }
          },
          "then": {
            "required": ["refinement_required", "refinement_trigger"],
            "properties": { "refinement_required": { "const": true } }
          }
        },
        {
          "if": {
            "required": ["refinement_required"],
            "properties": { "refinement_required": { "const": true } }
          },
          "then": { "required": ["refinement_trigger"] }
        },
        {
          "if": { "properties": { "status": { "const": "accepted" } } },
          "then": {
            "properties": {
              "evidence": { "minItems": 1 },
              "reviews": {
                "contains": {
                  "type": "object",
                  "properties": {
                    "reviewer_type": { "const": "human" },
                    "authorized": { "const": true },
                    "decision": { "const": "approve" }
                  },
                  "required": ["reviewer_type", "authorized", "decision"]
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "rejected" } } },
          "then": {
            "properties": {
              "reviews": {
                "contains": {
                  "type": "object",
                  "properties": {
                    "reviewer_type": { "const": "human" },
                    "authorized": { "const": true },
                    "decision": { "const": "reject" }
                  },
                  "required": ["reviewer_type", "authorized", "decision"]
                }
              }
            }
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "reviewer_type", "authorized", "decision", "evidence"],
      "properties": {
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewer_type": { "enum": ["human", "agent"] },
        "authorized": { "type": "boolean" },
        "decision": { "enum": ["approve", "reject"] },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "gateReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "reviewer_type", "authorized", "decision", "evidence"],
      "properties": {
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewer_type": { "enum": ["human", "agent"] },
        "authorized": { "type": "boolean" },
        "decision": { "enum": ["approve", "reject"] },
        "evidence": { "type": "string", "minLength": 1 },
        "gate_epoch": { "type": "integer", "minimum": 0 }
      }
    },
    "refinementTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_of"],
      "properties": {
        "all_of": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["subject", "condition"],
            "properties": {
              "subject": { "$ref": "#/$defs/identifier" },
              "condition": { "enum": ["accepted", "approved"] }
            }
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "status", "required_deliverables", "reviews"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["TR", "DCP", "Gate"] },
        "status": { "enum": ["planned", "ready", "approved", "rejected"] },
        "phase": { "type": ["string", "null"], "minLength": 1 },
        "required_deliverables": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "reviews": {
          "type": "array",
          "items": { "$ref": "#/$defs/gateReview" }
        },
        "evidence": { "$ref": "#/$defs/stringList" },
        "blockers": { "$ref": "#/$defs/stringList" },
        "approval": { "type": ["string", "null"], "minLength": 1 },
        "requirements_fingerprint": { "type": "string", "minLength": 1 },
        "review_epoch": { "type": "integer", "minimum": 0 },
        "stale": { "type": "boolean" },
        "stale_reason": { "type": ["string", "null"], "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "approved" } } },
          "then": {
            "properties": {
              "reviews": {
                "contains": {
                  "type": "object",
                  "properties": {
                    "reviewer_type": { "const": "human" },
                    "authorized": { "const": true },
                    "decision": { "const": "approve" }
                  },
                  "required": ["reviewer_type", "authorized", "decision"]
                }
              }
            }
          }
        }
      ]
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "relation"],
      "properties": {
        "source": { "$ref": "#/$defs/identifier" },
        "target": { "$ref": "#/$defs/identifier" },
        "relation": { "enum": ["supports", "depends_on", "verifies", "supersedes", "refines"] }
      }
    }
  }
}
