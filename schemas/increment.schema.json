{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "product_version": {
      "type": "string",
      "minLength": 1
    },
    "base_baseline": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirement": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*@[1-9][0-9]*$"
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "minItems": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "requirement",
          "criteria"
        ]
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "accepted"
      ]
    },
    "pack": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "path": {
          "type": "string"
        },
        "layer": {
          "type": "string",
          "enum": [
            "core",
            "organization",
            "project"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sha256",
        "path",
        "layer"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "product_version",
    "base_baseline",
    "scope",
    "status",
    "pack"
  ]
}
