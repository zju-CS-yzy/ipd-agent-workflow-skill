{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zju-CS-yzy/ipd-agent-workflow-skill/schemas/refinement_plan.schema.json",
  "title": "IPD Progressive Refinement Plan",
  "description": "An explicit, reviewable expansion of one declared Deliverable refinement root.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "root",
    "mode",
    "base_process_fingerprint",
    "reason",
    "basis",
    "activities",
    "deliverables",
    "dependencies"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "$ref": "#/$defs/identifier" },
    "root": { "$ref": "#/$defs/identifier" },
    "mode": { "const": "expand" },
    "base_process_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reason": { "type": "string", "minLength": 1 },
    "basis": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "activities": {
      "type": "array",
      "items": { "$ref": "#/$defs/activity" }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/deliverable" }
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "phaseId": {
      "enum": ["concept", "plan", "develop", "qualify", "launch", "lifecycle"]
    },
    "identifierList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "definitionState": {
      "enum": ["concrete", "placeholder", "abstract"]
    },
    "refinementTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_of"],
      "properties": {
        "all_of": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["subject", "condition"],
            "properties": {
              "subject": { "$ref": "#/$defs/identifier" },
              "condition": { "enum": ["accepted", "approved"] }
            }
          }
        }
      }
    },
    "activity": {
      "description": "A structural Activity node. Activities may carry definition_state and refines, but only Deliverables may declare refinement requirements or triggers.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "phase", "sequence"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1 },
        "phase": { "$ref": "#/$defs/phaseId" },
        "sequence": { "type": "integer", "minimum": 0 },
        "definition_state": { "$ref": "#/$defs/definitionState" },
        "refines": { "$ref": "#/$defs/identifier" }
      }
    },
    "deliverable": {
      "description": "An executable Deliverable node and the only entity type that may declare a nested refinement requirement and trigger.",
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": ["definition_state"],
            "properties": { "definition_state": { "const": "placeholder" } }
          },
          "then": {
            "required": ["refinement_required", "refinement_trigger"],
            "properties": { "refinement_required": { "const": true } }
          }
        },
        {
          "if": {
            "required": ["refinement_required"],
            "properties": { "refinement_required": { "const": true } }
          },
          "then": { "required": ["refinement_trigger"] }
        },
        {
          "if": {
            "required": ["definition_state"],
            "properties": {
              "definition_state": { "enum": ["abstract", "placeholder"] }
            }
          },
          "then": {
            "properties": { "requires_artifact_owner": { "const": false } }
          },
          "else": {
            "properties": { "requires_artifact_owner": { "const": true } }
          }
        }
      ],
      "required": [
        "id",
        "title",
        "phase",
        "activity_id",
        "review_required",
        "depends_on",
        "refines"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1 },
        "phase": { "$ref": "#/$defs/phaseId" },
        "activity_id": { "$ref": "#/$defs/identifier" },
        "review_required": { "const": true },
        "depends_on": { "$ref": "#/$defs/identifierList" },
        "definition_state": { "$ref": "#/$defs/definitionState" },
        "refinement_required": { "type": "boolean" },
        "refinement_trigger": { "$ref": "#/$defs/refinementTrigger" },
        "refines": { "$ref": "#/$defs/identifier" },
        "requires_artifact_owner": {
          "type": "boolean",
          "description": "Concrete children require true; abstract and placeholder children require false. Omission is normalized from definition_state by ipdctl."
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "relation"],
      "properties": {
        "source": { "$ref": "#/$defs/identifier" },
        "target": { "$ref": "#/$defs/identifier" },
        "relation": {
          "enum": ["depends_on", "supports", "verifies", "supersedes", "refines"]
        }
      }
    }
  }
}
