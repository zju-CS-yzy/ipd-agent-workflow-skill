{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "contract": {
      "type": "string",
      "enum": [
        "0.5.3"
      ]
    },
    "layer": {
      "type": "string",
      "enum": [
        "core",
        "organization",
        "project"
      ]
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "document_type": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "zh-CN"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "minItems": 1
          },
          "filename_pattern": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "requirement_kinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "IR",
                "SR",
                "AR"
              ]
            },
            "minItems": 1
          },
          "phases": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "concept",
                "plan",
                "develop",
                "qualify",
                "launch",
                "lifecycle"
              ]
            },
            "minItems": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "document_type",
          "id",
          "version",
          "locale",
          "path",
          "sections",
          "filename_pattern",
          "sha256",
          "requirement_kinds",
          "phases"
        ]
      },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "contract",
    "layer",
    "templates"
  ]
}
