{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IPD Agent Runtime",
  "$defs": {
    "artifactBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "bindings_sha256",
        "repository",
        "paths",
        "snapshot_sha256",
        "baseline_id"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "bindings_sha256": { "type": "string", "minLength": 1 },
        "repository": { "type": "object" },
        "paths": {
          "type": "object",
          "additionalProperties": { "type": ["string", "null"] }
        },
        "snapshot_sha256": { "type": "string", "minLength": 1 },
        "baseline_id": { "type": "string", "minLength": 1 }
      }
    },
    "bindingWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "bindings_sha256",
        "baseline_id",
        "opened_paths",
        "snapshot_sha256"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "bindings_sha256": { "type": "string", "minLength": 1 },
        "baseline_id": { "type": ["string", "null"] },
        "opened_paths": {
          "type": "object",
          "additionalProperties": { "type": ["string", "null"] }
        },
        "snapshot_sha256": { "type": "string", "minLength": 1 }
      }
    },
    "processMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "strategy", "reason", "preserve_history"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "strategy": { "enum": ["replace", "split"] },
        "reason": { "type": "string", "minLength": 1 },
        "preserve_history": { "const": true }
      }
    },
    "gateMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "reason", "preserve_history"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "preserve_history": { "const": true }
      }
    },
    "dependencyCorrection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deliverable",
        "before",
        "after",
        "reason",
        "preserve_history",
        "require_reapproval"
      ],
      "properties": {
        "deliverable": { "type": "string", "minLength": 1 },
        "before": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "after": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "reason": { "type": "string", "minLength": 1 },
        "preserve_history": { "const": true },
        "require_reapproval": { "const": true }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "active_claims",
    "events",
    "last_refresh",
    "last_verification"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "revision": { "type": "integer", "minimum": 0 },
    "active_claims": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["deliverable", "actor", "started_at", "expires_at"],
        "properties": {
          "deliverable": { "type": "string", "minLength": 1 },
          "actor": { "type": "string", "minLength": 1 },
          "started_at": { "type": "string", "format": "date-time" },
          "expires_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "at"],
        "properties": {
          "action": { "type": "string", "minLength": 1 },
          "at": { "type": "string", "format": "date-time" },
          "deliverable": { "type": "string", "minLength": 1 },
          "subject": { "type": "string", "minLength": 1 },
          "subject_type": { "enum": ["deliverable", "gate"] },
          "actor": { "type": "string", "minLength": 1 },
          "from_phase": { "type": "string", "minLength": 1 },
          "to_phase": { "type": "string", "minLength": 1 },
          "state_revision": { "type": "integer", "minimum": 0 },
          "binding_window": { "$ref": "#/$defs/bindingWindow" },
          "actor_type": { "type": "string", "enum": ["agent", "human"] },
          "authorized": { "type": "boolean" },
          "reason": { "type": "string", "minLength": 1 },
          "baseline_id": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["passed", "failed"] },
          "input_fingerprint": { "type": "string", "minLength": 1 },
          "artifact_baseline": { "$ref": "#/$defs/artifactBaseline" },
          "previous_process_schema_version": { "enum": ["1.0", "2.0"] },
          "process_schema_version": { "const": "2.0" },
          "migrations": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/processMigration" }
          },
          "gate_migrations": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/gateMigration" }
          },
          "dependency_corrections": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/dependencyCorrection" }
          },
          "plan_id": { "type": "string", "minLength": 1 },
          "plan_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "base_process_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "result_process_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "root": { "type": "string", "minLength": 1 },
          "children": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "invalidated_gates": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "action": { "const": "claim" } },
              "required": ["action"]
            },
            "then": {
              "required": ["deliverable", "actor", "state_revision"]
            }
          },
          {
            "if": {
              "properties": { "action": { "const": "advance_phase" } },
              "required": ["action"]
            },
            "then": {
              "required": ["from_phase", "to_phase", "state_revision"]
            }
          },
          {
            "if": {
              "properties": {
                "action": { "const": "artifact_baseline_adopted" }
              },
              "required": ["action"]
            },
            "then": {
              "required": [
                "actor",
                "actor_type",
                "authorized",
                "reason",
                "state_revision",
                "baseline_id",
                "artifact_baseline"
              ],
              "properties": {
                "actor_type": { "const": "human" },
                "authorized": { "const": true }
              }
            }
          },
          {
            "if": {
              "properties": { "action": { "const": "process_migration" } },
              "required": ["action"]
            },
            "then": {
              "required": [
                "actor",
                "actor_type",
                "authorized",
                "reason",
                "state_revision",
                "previous_process_schema_version",
                "process_schema_version"
              ],
              "anyOf": [
                { "required": ["migrations"] },
                { "required": ["gate_migrations"] },
                { "required": ["dependency_corrections"] }
              ],
              "properties": {
                "actor_type": { "const": "human" },
                "authorized": { "const": true }
              }
            }
          },
          {
            "if": {
              "properties": {
                "action": { "const": "process_refinement_applied" }
              },
              "required": ["action"]
            },
            "then": {
              "required": [
                "actor",
                "actor_type",
                "authorized",
                "reason",
                "state_revision",
                "plan_id",
                "plan_digest",
                "base_process_fingerprint",
                "result_process_fingerprint",
                "root",
                "children",
                "invalidated_gates"
              ],
              "properties": {
                "actor_type": { "const": "human" },
                "authorized": { "const": true }
              }
            }
          },
          {
            "if": {
              "properties": {
                "action": { "const": "review_subject_recovered" }
              },
              "required": ["action"]
            },
            "then": {
              "required": [
                "subject",
                "subject_type",
                "actor",
                "actor_type",
                "authorized",
                "reason",
                "state_revision"
              ],
              "properties": {
                "actor_type": { "const": "human" },
                "authorized": { "const": true }
              }
            }
          }
        ]
      }
    },
    "last_refresh": { "type": ["object", "null"] },
    "last_verification": { "type": ["object", "null"] }
  }
}
