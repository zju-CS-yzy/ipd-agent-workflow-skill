{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IPD Agent Runtime",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "active_claims",
    "events",
    "last_refresh",
    "last_verification"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "revision": { "type": "integer", "minimum": 0 },
    "active_claims": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["deliverable", "actor", "started_at", "expires_at"],
        "properties": {
          "deliverable": { "type": "string", "minLength": 1 },
          "actor": { "type": "string", "minLength": 1 },
          "started_at": { "type": "string", "format": "date-time" },
          "expires_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "at"],
        "properties": {
          "action": { "type": "string", "minLength": 1 },
          "at": { "type": "string", "format": "date-time" },
          "deliverable": { "type": "string", "minLength": 1 },
          "actor": { "type": "string", "minLength": 1 },
          "from_phase": { "type": "string", "minLength": 1 },
          "to_phase": { "type": "string", "minLength": 1 },
          "state_revision": { "type": "integer", "minimum": 0 }
        },
        "allOf": [
          {
            "if": {
              "properties": { "action": { "const": "claim" } },
              "required": ["action"]
            },
            "then": {
              "required": ["deliverable", "actor", "state_revision"]
            }
          },
          {
            "if": {
              "properties": { "action": { "const": "advance_phase" } },
              "required": ["action"]
            },
            "then": {
              "required": ["from_phase", "to_phase", "state_revision"]
            }
          }
        ]
      }
    },
    "last_refresh": { "type": ["object", "null"] },
    "last_verification": { "type": ["object", "null"] }
  }
}
