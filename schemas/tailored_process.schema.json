{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zju-CS-yzy/ipd-agent-workflow-skill/schemas/tailored_process.schema.json",
  "title": "Tailored IPD Process",
  "description": "Deterministic process definition generated from an IPD task profile.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "schema_version": { "const": "2.0" } },
        "required": ["schema_version"]
      },
      "then": {
        "required": ["migrations"],
        "properties": {
          "profile": { "required": ["name", "task_types", "capability_patterns"] },
          "phases": { "items": { "required": ["provenance", "maturity"] } },
          "technical_reviews": {
            "items": { "required": ["criteria", "provenance", "maturity"] }
          },
          "decision_checkpoints": {
            "items": { "required": ["criteria", "provenance", "maturity"] }
          },
          "gates": { "items": { "required": ["provenance", "maturity"] } },
          "activities": { "items": { "required": ["provenance", "maturity"] } },
          "deliverables": { "items": { "required": ["provenance", "maturity"] } },
          "dependencies": { "items": { "required": ["provenance"] } }
        }
      },
      "else": { "not": { "required": ["migrations"] } }
    }
  ],
  "required": [
    "schema_version",
    "profile",
    "phases",
    "technical_reviews",
    "decision_checkpoints",
    "gates",
    "activities",
    "deliverables",
    "dependencies",
    "review_requirements"
  ],
  "properties": {
    "schema_version": { "enum": ["1.0", "2.0"] },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "task_types"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "task_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "software",
              "hardware",
              "embedded",
              "robotics",
              "ai_system",
              "material_change"
            ]
          }
        },
        "capability_patterns": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "sourced_component_integration",
              "module_decomposition_and_verification",
              "interface_contract_and_integration",
              "release_and_lifecycle_assurance"
            ]
          }
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/phase" }
    },
    "technical_reviews": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/checkpoint" }
    },
    "decision_checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/checkpoint" }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gate" }
    },
    "activities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/activity" }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/deliverable" }
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "review_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/reviewRequirement" }
    },
    "migrations": {
      "type": "array",
      "items": { "$ref": "#/$defs/migration" }
    },
    "gate_migrations": {
      "type": "array",
      "items": { "$ref": "#/$defs/gateMigration" }
    },
    "dependency_corrections": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependencyCorrection" }
    },
    "refinements": {
      "type": "array",
      "items": { "$ref": "#/$defs/appliedRefinement" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "phaseId": {
      "enum": ["concept", "plan", "develop", "qualify", "launch", "lifecycle"]
    },
    "identifierList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "source_id"],
      "properties": {
        "layer": { "enum": ["core", "task_type", "capability", "project"] },
        "source_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "maturity": {
      "enum": ["defined", "selected", "integrated", "verified", "released", "monitored"]
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "evidence_required"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "description": { "type": "string", "minLength": 1 },
        "evidence_required": { "const": true }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "sequence"],
      "properties": {
        "id": { "$ref": "#/$defs/phaseId" },
        "title": { "type": "string", "minLength": 1 },
        "sequence": { "type": "integer", "minimum": 0 },
        "provenance": { "$ref": "#/$defs/provenance" },
        "maturity": { "$ref": "#/$defs/maturity" }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "phase", "sequence", "gate_id", "required_deliverables"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1 },
        "phase": { "$ref": "#/$defs/phaseId" },
        "sequence": { "type": "integer", "minimum": 0 },
        "gate_id": { "$ref": "#/$defs/identifier" },
        "required_deliverables": { "$ref": "#/$defs/identifierList" },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/criterion" }
        },
        "provenance": { "$ref": "#/$defs/provenance" },
        "maturity": { "$ref": "#/$defs/maturity" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "kind",
        "phase",
        "checkpoint_id",
        "required_deliverables",
        "review_required",
        "final_approval"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["TR", "DCP", "Gate"] },
        "phase": { "$ref": "#/$defs/phaseId" },
        "checkpoint_id": { "$ref": "#/$defs/identifier" },
        "required_deliverables": { "$ref": "#/$defs/identifierList" },
        "review_required": { "const": true },
        "final_approval": { "const": "authorized_human" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "maturity": { "$ref": "#/$defs/maturity" }
      }
    },
    "activity": {
      "description": "A structural Activity node. Activities may carry definition_state and refines, but only Deliverables may declare refinement requirements or triggers.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "phase", "sequence"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1 },
        "phase": { "$ref": "#/$defs/phaseId" },
        "sequence": { "type": "integer", "minimum": 0 },
        "provenance": { "$ref": "#/$defs/provenance" },
        "maturity": { "$ref": "#/$defs/maturity" },
        "definition_state": { "$ref": "#/$defs/definitionState" },
        "refines": { "$ref": "#/$defs/identifier" }
      }
    },
    "deliverable": {
      "description": "An executable Deliverable node and the only entity type that may declare a refinement requirement and trigger.",
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": ["definition_state"],
            "properties": { "definition_state": { "const": "placeholder" } }
          },
          "then": {
            "required": ["refinement_required", "refinement_trigger"],
            "properties": { "refinement_required": { "const": true } }
          }
        },
        {
          "if": {
            "required": ["refinement_required"],
            "properties": { "refinement_required": { "const": true } }
          },
          "then": { "required": ["refinement_trigger"] }
        }
      ],
      "required": ["id", "title", "phase", "activity_id", "review_required", "depends_on"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1 },
        "phase": { "$ref": "#/$defs/phaseId" },
        "activity_id": { "$ref": "#/$defs/identifier" },
        "review_required": { "type": "boolean" },
        "depends_on": { "$ref": "#/$defs/identifierList" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "maturity": { "$ref": "#/$defs/maturity" },
        "definition_state": { "$ref": "#/$defs/definitionState" },
        "refinement_required": { "type": "boolean" },
        "refinement_trigger": { "$ref": "#/$defs/refinementTrigger" },
        "completion_policy": { "const": "all_children_accepted" },
        "refines": { "$ref": "#/$defs/identifier" },
        "requires_artifact_owner": { "type": "boolean" }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "relation"],
      "properties": {
        "source": { "$ref": "#/$defs/identifier" },
        "target": { "$ref": "#/$defs/identifier" },
        "relation": { "enum": ["depends_on", "supports", "verifies", "supersedes", "refines"] },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "strategy", "reason", "preserve_history"],
      "properties": {
        "from": { "$ref": "#/$defs/identifier" },
        "to": { "$ref": "#/$defs/identifier" },
        "strategy": { "enum": ["replace", "split"] },
        "reason": { "type": "string", "minLength": 1 },
        "preserve_history": { "const": true }
      }
    },
    "gateMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "reason", "preserve_history"],
      "properties": {
        "from": { "$ref": "#/$defs/identifier" },
        "to": { "$ref": "#/$defs/identifier" },
        "reason": { "type": "string", "minLength": 1 },
        "preserve_history": { "const": true }
      }
    },
    "dependencyCorrection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deliverable",
        "before",
        "after",
        "reason",
        "preserve_history",
        "require_reapproval"
      ],
      "properties": {
        "deliverable": { "$ref": "#/$defs/identifier" },
        "before": { "$ref": "#/$defs/identifierList" },
        "after": { "$ref": "#/$defs/identifierList" },
        "reason": { "type": "string", "minLength": 1 },
        "preserve_history": { "const": true },
        "require_reapproval": { "const": true }
      }
    },
    "definitionState": {
      "enum": ["concrete", "placeholder", "abstract"]
    },
    "refinementTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_of"],
      "properties": {
        "all_of": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["subject", "condition"],
            "properties": {
              "subject": { "$ref": "#/$defs/identifier" },
              "condition": { "enum": ["accepted", "approved"] }
            }
          }
        }
      }
    },
    "appliedRefinement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "root",
        "mode",
        "base_process_fingerprint",
        "reason",
        "basis",
        "plan_digest",
        "children"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "root": { "$ref": "#/$defs/identifier" },
        "mode": { "const": "expand" },
        "base_process_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "reason": { "type": "string", "minLength": 1 },
        "basis": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "plan_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "result_process_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "invalidated_gates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "reviewRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject_type",
        "subject_id",
        "reviewer_type",
        "authorization_required",
        "decision_required"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "subject_type": { "enum": ["deliverable", "gate"] },
        "subject_id": { "$ref": "#/$defs/identifier" },
        "reviewer_type": { "enum": ["human", "agent"] },
        "authorization_required": { "type": "boolean" },
        "decision_required": { "type": "boolean" }
      }
    }
  }
}
